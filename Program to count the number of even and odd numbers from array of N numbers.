n <- as.integer(readline("Enter the number of elements: "))

numbers <- numeric(n)

for (i in 1:n) {
  numbers[i] <- as.integer(readline(paste("Enter number", i, ": ")))
}

even_count <- 0
odd_count <- 0

for (i in 1:n) {
  if (numbers[i] %% 2 == 0) {
    even_count <- even_count + 1
  } else {
    odd_count <- odd_count + 1
  }
}

cat("Number of even numbers =", even_count, "\n")
cat("Number of odd numbers =", odd_count)
